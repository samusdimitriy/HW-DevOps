pipeline {
  agent {
    kubernetes {
      label 'kaniko'
      defaultContainer 'git'
      yaml """
apiVersion: v1
kind: Pod
metadata:
  labels:
    jenkins/label: kaniko
spec:
  serviceAccountName: lesson-7-jenkins
  volumes:
    - name: workspace-volume
      emptyDir: {}
  containers:
    - name: git
      image: alpine/git:2.45.2
      command: ["/bin/sh", "-c", "cat"]
      tty: true
      workingDir: /workspace
      volumeMounts:
        - name: workspace-volume
          mountPath: /workspace
      env:
        - name: AWS_REGION
          value: "us-west-2"
        - name: AWS_DEFAULT_REGION
          value: "us-west-2"
        - name: AWS_SDK_LOAD_CONFIG
          value: "1"
        - name: AWS_EC2_METADATA_DISABLED
          value: "true"
        - name: AWS_ACCESS_KEY_ID
          valueFrom:
            secretKeyRef:
              name: jenkins-aws-creds
              key: aws_access_key_id
        - name: AWS_SECRET_ACCESS_KEY
          valueFrom:
            secretKeyRef:
              name: jenkins-aws-creds
              key: aws_secret_access_key
    - name: kaniko
      image: gcr.io/kaniko-project/executor:v1.23.2-debug
      # Keep the container alive for exec; use tail to avoid exit
      command: ["/bin/sh"]
      args: ["-c", "tail -f /dev/null"]
      tty: true
      workingDir: /workspace
      resources:
        requests:
          cpu: "300m"
          memory: "512Mi"
        limits:
          cpu: "800m"
          memory: "1024Mi"
      env:
        - name: AWS_REGION
          value: "us-west-2"
        - name: AWS_DEFAULT_REGION
          value: "us-west-2"
        - name: AWS_SDK_LOAD_CONFIG
          value: "1"
        - name: AWS_EC2_METADATA_DISABLED
          value: "true"
        - name: AWS_ACCESS_KEY_ID
          valueFrom:
            secretKeyRef:
              name: jenkins-aws-creds
              key: aws_access_key_id
        - name: AWS_SECRET_ACCESS_KEY
          valueFrom:
            secretKeyRef:
              name: jenkins-aws-creds
              key: aws_secret_access_key
      volumeMounts:
        - name: workspace-volume
          mountPath: /workspace
"""
    }
  }

  options {
    skipDefaultCheckout(true)
  }

  environment {
    AWS_REGION          = 'us-west-2'
    AWS_DEFAULT_REGION = 'us-west-2'
    ECR_REPOSITORY     = '431969328609.dkr.ecr.us-west-2.amazonaws.com/lesson-7-django-ecr'
    DOCKERFILE_PATH    = 'lesson-7/app/Dockerfile'
    BUILD_CONTEXT      = 'lesson-7/app'
    HELM_VALUES_FILE   = 'lesson-7/charts/django-app/values.yaml'
    GIT_TARGET_BRANCH  = 'lesson-8-9'
    GIT_CREDENTIALS_ID = 'github-token'
  }

  stages {
    stage('Checkout') {
      steps {
        container('git') {
          checkout scm
        }
      }
    }

    stage('ECR login config') {
      steps {
        container('git') {
          sh '''
            apk add --no-cache python3 py3-pip >/dev/null
            python3 -m pip install --no-cache-dir --break-system-packages awscli >/dev/null
            mkdir -p /workspace/.docker
            export AWS_REGION=${AWS_REGION:-${AWS_DEFAULT_REGION}}
            export AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION}
            PASSWORD=$(aws ecr get-login-password --region ${AWS_REGION})
            export PASSWORD
            python3 <<'PY'
import json, base64, os, pathlib
pw = os.environ["PASSWORD"]
auth = base64.b64encode(f"AWS:{pw}".encode()).decode()
conf = {"auths": {"431969328609.dkr.ecr.us-west-2.amazonaws.com": {"auth": auth}}}
pathlib.Path("/workspace/.docker/config.json").write_text(json.dumps(conf))
PY
          '''
        }
      }
    }

    stage('Prepare metadata') {
      steps {
        script {
          env.IMAGE_TAG = "build-${env.BUILD_NUMBER}"
          env.GIT_COMMIT_MESSAGE = "ci: release ${env.IMAGE_TAG}"
        }
      }
    }

    stage('Build & Push image') {
      steps {
        container('kaniko') {
          sh '''
            export DOCKER_CONFIG=/workspace/.docker
            /kaniko/executor \
              --context=$WORKSPACE/${BUILD_CONTEXT} \
              --dockerfile=$WORKSPACE/${DOCKERFILE_PATH} \
              --destination=${ECR_REPOSITORY}:${IMAGE_TAG} \
              --destination=${ECR_REPOSITORY}:latest \
              --snapshotMode=redo \
              --verbosity=info
          '''
        }
      }
    }

    stage('Update Helm chart') {
      steps {
        container('git') {
          sh '''
            apk add --no-cache python3 py3-pip >/dev/null
            python3 -m pip install --no-cache-dir --break-system-packages pyyaml >/dev/null
            python3 <<'PY'
import os
import pathlib
import yaml
values_path = pathlib.Path(os.environ['WORKSPACE']) / os.environ['HELM_VALUES_FILE']
data = yaml.safe_load(values_path.read_text())
data.setdefault('image', {})
data['image']['repository'] = os.environ['ECR_REPOSITORY']
data['image']['tag'] = os.environ['IMAGE_TAG']
values_path.write_text(yaml.safe_dump(data, sort_keys=False))
PY
            git status --short ${HELM_VALUES_FILE}
          '''
        }
      }
    }

    stage('Commit changes') {
      steps {
        container('git') {
          script {
            def changes = sh(script: 'git status --short', returnStdout: true).trim()
            if (!changes) {
              echo 'No changes detected, skipping git commit'
              env.SKIP_GIT_PUSH = 'true'
            } else {
              sh '''
                git config user.name "Jenkins CI"
                git config user.email "jenkins@example.com"
              '''
              sh "git add ${HELM_VALUES_FILE}"
              sh "git commit -m \"${env.GIT_COMMIT_MESSAGE}\""
            }
          }
        }
      }
    }

    stage('Push to Git') {
      when {
        expression { env.SKIP_GIT_PUSH != 'true' }
      }
      steps {
        container('git') {
          withCredentials([usernamePassword(credentialsId: env.GIT_CREDENTIALS_ID, usernameVariable: 'GIT_USERNAME', passwordVariable: 'GIT_PASSWORD')]) {
            sh '''
              git push https://${GIT_USERNAME}:${GIT_PASSWORD}@github.com/samusdimitriy/HW-DevOps.git HEAD:${GIT_TARGET_BRANCH}
            '''
          }
        }
      }
    }
  }
}
